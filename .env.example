# Advocate DigiDiary Environment Configuration

# Server
PORT=5000
NODE_ENV=development

# MongoDB Database Connection
# In production, MONGODB_URI is mandatory (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/advocate_digidiary?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/advocate_digidiary

# Authentication & Session Secrets
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_secret_key_2026

# Application URL
APP_URL=http://localhost:5000

# Google Gemini API Key (For AI Legal Assistant & Document Summarizer)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
