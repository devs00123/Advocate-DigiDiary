{
  "name": "advocate-digidiary",
  "version": "1.2.1",
  "description": "Advocate DigiDiary - Digital Legal Practice Companion & Court Diary",
  "main": "electron/main.js",
  "author": "Advocate DigiDiary Team",
  "license": "ISC",
  "scripts": {
    "start": "node server/server.js",
    "dev": "nodemon server/server.js",
    "desktop": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "seed": "node server/scripts/seed.js",
    "cleanup-demo": "node server/scripts/cleanup-demo.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit"
  },
  "publish": {
    "provider": "github",
    "owner": "devs00123",
    "repo": "Advocate-DigiDiary"
  },
  "build": {
    "appId": "com.advocatedigidiary.app",
    "productName": "Advocate DigiDiary",
    "publish": {
      "provider": "github",
      "owner": "devs00123",
      "repo": "Advocate-DigiDiary"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "public/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/bcryptjs/**",
      "node_modules/mongoose/**",
      "node_modules/mongodb-memory-server/**",
      "node_modules/mongodb/**",
      "node_modules/bson/**",
      "node_modules/pdfkit/**",
      "node_modules/exceljs/**",
      "server/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Advocate DigiDiary"
    }
  },
  "keywords": [
    "legal",
    "practice-management",
    "court-diary",
    "advocate",
    "law-firm"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^9.4.0",
    "mongoose": "^8.5.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.15.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  }
}
